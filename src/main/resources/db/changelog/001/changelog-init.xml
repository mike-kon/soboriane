<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1774282777624-1" author="koma"  failOnError="true">
        <createTable remarks="сообщение" tableName="message">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="message_pk"/>
            </column>
            <column defaultValueComputed="now()" name="created" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="owner" remarks="Кто отправил" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="type" remarks="Тип сообщения" type="VARCHAR">
                <constraints nullable="false" />
            </column>
            <column name="message" remarks="Текст сообщения" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="prayer" type="TEXT[]">/>
            </column>
        </createTable>
        <createTable remarks="список для молитвы" tableName="prayer_list">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="prayer_list_pk"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="what" remarks="о здравии или об упокоении" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="owner" remarks="Подавший" type="VARCHAR"/>
            <column name="submitted" remarks="Дата подачи" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="terminated" remarks="Дата окончания молитвы." type="date"/>
            <column name="is_main" remarks="основной список или 3-я Слава" type="BOOLEAN"/>
            <column defaultValue="CREATED" name="status"
                    remarks="Статус подана,принята,  дискуссиона, отклонена, закончена" type="VARCHAR">
                <constraints nullable="false" />
            </column>
            <column name="message_ref" type="uuid">
            </column>
        </createTable>
        <createTable tableName="shadow">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="shadow_pk"/>
            </column>
            <column name="user" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="password" remarks="ХЭШ пароля" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column defaultValueBoolean="true" name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created" remarks="появление пароля" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="expires" remarks="Время,  до которого действует пароль" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="app_user">
            <column name="nick" remarks="Имя полбьзователя в системе" type="VARCHAR(32)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="app_user_pk"/>
            </column>
            <column name="name" remarks="Имя пользователя" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="family" remarks="Фамилия пользователя" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="birthday" remarks="день рождения" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="angel_days"
                    remarks="День Ангела (по Григорианскому календарю).&#13;&#10;День указывается в нулевом году."
                    type="date"/>
            <column name="number" remarks="Номер в двадцатке" type="INT"/>
            <column defaultValueBoolean="false" name="is_admin" remarks="Является администратором" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="day_begin" remarks="дата начала чтения" type="date"/>
            <column name="day_end" remarks="дата окончания чтения" type="date"/>
        </createTable>
        <createIndex indexName="prayer_list_name_idx" tableName="prayer_list">
            <column name="name"/>
            <column name="is_main"/>
            <column name="submitted"/>
        </createIndex>
        <createIndex indexName="prayer_list_submitted_idx" tableName="prayer_list">
            <column name="submitted"/>
        </createIndex>
        <createIndex indexName="prayer_list_terminated_idx" tableName="prayer_list">
            <column name="terminated"/>
        </createIndex>
        <createIndex indexName="prayer_list_what_idx" tableName="prayer_list">
            <column name="what"/>
            <column name="is_main"/>
        </createIndex>
        <createIndex indexName="shadow_user_idx" tableName="shadow">
            <column name="user"/>
            <column defaultValueBoolean="true" name="enabled"/>
        </createIndex>
        <createIndex indexName="shadow_user_time_idx" tableName="shadow">
            <column name="user"/>
            <column name="created"/>
            <column name="expires"/>
        </createIndex>
        <createIndex indexName="user_day_begin_idx" tableName="app_user">
            <column name="day_begin"/>
            <column name="day_end"/>
        </createIndex>
        <createIndex indexName="user_name_idx" tableName="app_user" unique="true">
            <column name="name"/>
            <column name="family"/>
            <column name="birthday"/>
        </createIndex>
        <createIndex indexName="user_number_idx" tableName="app_user">
            <column name="number"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="message_ref" baseTableName="prayer_list"
                                 constraintName="prayer_list_message_fk" onDelete="NO ACTION" referencedColumnNames="id"
                                 referencedTableName="message"/>
        <addForeignKeyConstraint baseColumnNames="owner" baseTableName="prayer_list"
                                 constraintName="prayer_list_user_fk" onDelete="NO ACTION" referencedColumnNames="nick"
                                 referencedTableName="app_user"/>
        <createIndex indexName="prayer_list_owner_idx" tableName="prayer_list">
            <column name="owner"/>
        </createIndex>
        <sql>
            ALTER TABLE soboriane.message ADD CONSTRAINT message_check_type
                CHECK (type in ('PRAYER','GREETING','MESSAGE','ADMIN'));
            ALTER TABLE soboriane.message ADD CONSTRAINT message_check_prayer
                CHECK (CASE WHEN type = 'PRAYER' THEN prayer IS NOT NULL ELSE true END);
            ALTER TABLE soboriane.prayer_list ADD CONSTRAINT first_and_second
                CHECK (CASE WHEN is_main THEN (owner IS NOT NULL) ELSE true END);
            ALTER TABLE soboriane.prayer_list ADD CONSTRAINT prayer_list_check_message_ref
                CHECK (CASE WHEN (NOT is_main) THEN (message_ref IS NOT NULL) ELSE true END);
            ALTER TABLE soboriane.prayer_list ADD CONSTRAINT prayer_list_check_status
                CHECK (status in ('CREATED','ACCEPTED','DISCUSSION','DROP','DONE'));
            ALTER TABLE soboriane.prayer_list ADD CONSTRAINT prayer_list_check_what
                CHECK (what in ('HEALTH','REPOSE'));
            ALTER TABLE soboriane.app_user ADD CONSTRAINT user_check
                CHECK (((number &gt;= 1) AND (number &lt;= 20)));
        </sql>

    </changeSet>

</databaseChangeLog>