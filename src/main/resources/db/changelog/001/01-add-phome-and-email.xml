<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1776695039481-1" author="koma">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="app_user" columnName="phone"/>
            </not>
        </preConditions>
        <addColumn tableName="app_user">
            <column name="phone" type="text" defaultValue="+7" remarks="телефон">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="app_user">
            <column name="email" type="text" defaultValue="noemail@nodomain.org" remarks="Почта">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="app_user" indexName="app_user_nick_idx">
            <column name="nick"/>
            <column name="phone"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>